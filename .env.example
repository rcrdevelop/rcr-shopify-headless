# Quasar solo expone al cliente variables con prefijo QCLI_
QCLI_FIREBASE_API_KEY=
QCLI_FIREBASE_AUTH_DOMAIN=
QCLI_FIREBASE_PROJECT_ID=
QCLI_FIREBASE_STORAGE_BUCKET=
QCLI_FIREBASE_MESSAGING_SENDER_ID=
QCLI_FIREBASE_APP_ID=

# Opcional: "true" fuerza el uso de los emuladores locales.
# Sin esta flag, el modo emulador se auto-detecta cuando la app
# se sirve desde el Hosting emulator (localhost:5000).
QCLI_USE_FIREBASE_EMULATOR=

# Opcional: host/puertos de los emuladores (deben coincidir con firebase.json)
QCLI_EMULATOR_HOST=
QCLI_EMULATOR_AUTH_PORT=
QCLI_EMULATOR_FIRESTORE_PORT=
